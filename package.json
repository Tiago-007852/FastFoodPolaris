{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && bun run build:api",
    "build:api": "esbuild server/app.ts --bundle --platform=node --format=cjs --target=node20 --outfile=api/_app.cjs --log-level=warning",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "api": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:import": "tsx scripts/import-firestore.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:check:products": "tsx scripts/products-check.ts",
    "db:check:admin": "tsx scripts/admin-flow-check.ts",
    "db:check:countdown": "tsx scripts/countdown-check.ts",
    "db:check:vercel": "bun run build:api && tsx scripts/vercel-handler-check.ts",
    "db:check:resilience": "bun run build:api && env -u DATABASE_URL -u BETTER_AUTH_SECRET tsx scripts/resilience-check.ts",
    "db:check:lambda": "bun run build:api && tsx scripts/lambda-bundle-check.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-auth": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.23.15",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
